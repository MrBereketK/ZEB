# SQLite file used for local development
DATABASE_URL="file:./dev.db"

# Static key required in the X-API-Key header for every /admin/* route (NFR-SEC-7)
ADMIN_API_KEY="change-me-to-a-long-random-string"

# Secret used to sign JWTs (HS256). Use a long random string, never reuse ADMIN_API_KEY.
JWT_SECRET="change-me-too"

PORT=3000
